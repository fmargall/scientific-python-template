# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,py.jinja}]
max_line_length = 100

[*.{yaml,yml,json,cff,yaml.jinja,yml.jinja,json.jinja,cff.jinja}]
indent_size = 2

# Optional files, whose name ends with "{% endif %}.jinja" instead of their extension
[*.{yaml,yml}*.jinja]
indent_size = 2

[*.{md,md.jinja}]
# Two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
