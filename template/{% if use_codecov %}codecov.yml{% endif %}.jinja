{#- Number of coverage uploads of the tests job of ci.yml: one per Python version
    of the matrix, plus the run with the newest versions of the dependencies -#}
{%- set uploads = (python_max_version.split('.')[1] | int) - (python_min_version.split('.')[1] | int) + 2 -%}
coverage:
  status:
    project:
      default:
        target: auto
        threshold: 1%
    patch:
      default:
        # Same threshold as fail_under in [tool.coverage.report] of pyproject.toml
        target: 90%

codecov:
  notify:
    # Wait for the uploads of all the runs of the tests job of ci.yml. Computed
    # from the Python versions by the template: `copier update` keeps it in sync
    after_n_builds: {{ uploads }}

comment:
  # Same as codecov.notify.after_n_builds
  after_n_builds: {{ uploads }}
